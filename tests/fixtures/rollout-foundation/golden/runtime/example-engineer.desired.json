{
  "agents/entries/example-engineer/workspace": "/workspace",
  "channels/a2a/enabled": true,
  "channels/a2a/exposeAgents": [
    "example-engineer"
  ],
  "channels/a2a/peers/lead": {
    "outboundToken": "${EXAMPLE_ENGINEER_TO_LEAD}",
    "token": "${EXAMPLE_LEAD_TO_ENGINEER}",
    "url": "http://example-lead:18789/a2a/v1"
  },
  "mcp/servers/onshape": {
    "connectionTimeoutMs": 5000,
    "enabled": true,
    "requestTimeoutMs": 30000,
    "supportsParallelToolCalls": false,
    "toolFilter": {
      "include": [
        "onshape_auth_status",
        "onshape_api_explain",
        "onshape_api_schema",
        "onshape_api_call"
      ]
    },
    "transport": "streamable-http",
    "url": "http://clawonshape-mcp:8080/mcp"
  },
  "plugins/entries/a2a/enabled": true
}
