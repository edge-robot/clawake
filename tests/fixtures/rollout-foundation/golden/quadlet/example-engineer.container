[Quadlet]
DefaultDependencies=false

[Unit]
Description=OpenClaw instance example-engineer

[Container]
ContainerName=example-engineer
Image=ghcr.io/example/openclaw:2026.1.1@sha256:1111111111111111111111111111111111111111111111111111111111111111
UserNS=keep-id:uid=1000,gid=1000
EnvironmentFile=/srv/example/env/engineer.env
Volume=/srv/example/engineer/workspace:/workspace
Volume=/srv/example/roles/engineer:/team-definition:ro
Volume=/srv/example/engineer/state:/home/node/.openclaw
Network=example-team.network
Network=example-mcp-private.network
NetworkAlias=example-engineer
Volume=/srv/example/shared/briefs:/mnt/briefs:ro
Volume=/srv/example/engineer/renders:/mnt/renders
Volume=/srv/example/shared/keys:/mnt/keys:ro
Volume=/srv/example/packages/example-cad-0.0.1.tgz:/opt/clawake/plugins/example-cad.tgz:ro
PublishPort=127.0.0.1:19002:18789/tcp
Exec=openclaw gateway run --bind lan --port 18789 --allow-unconfigured
Label=clawake.instance=example-engineer
Label=clawake.role=developer

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
