{
  "tools": {
    "allow": [
      "read",
      "cad_delegate_render",
      "cad_delegate_task"
    ]
  },
  "plugins": {
    "entries": {
      "example-cad": {
        "enabled": true,
        "config": {
          "bindings": [
            {
              "agentId": "example-lead",
              "requesterSenderId": "000000000000000001",
              "messageChannel": "discord",
              "agentAccountId": "example-lead",
              "discordChannelId": "000000000000000002",
              "connectionRef": "example-connection",
              "documentId": "000000000000000000000001",
              "primaryWorkspaceId": "000000000000000000000002",
              "workspaceId": "000000000000000000000002",
              "elementId": "000000000000000000000003"
            }
          ],
          "liveReads": false,
          "engineerAgentId": "example-engineer",
          "delegation": {
            "leadAgentId": "example-lead",
            "engineerAgentId": "example-engineer",
            "peerSenderId": "000000000000000003",
            "accountId": "example-lead",
            "keyFile": "/mnt/keys/delegation.key"
          }
        }
      }
    }
  },
  "agents": {
    "entries": {
      "example-lead": {
        "tools": {
          "alsoAllow": [
            "message",
            "cad_delegate_render",
            "cad_delegate_task"
          ]
        }
      }
    }
  }
}
