# Diese Datei je Agent nach robotics-team/env/<agent>.env kopieren.
# Niemals echte Werte committen.
OPENCLAW_GATEWAY_TOKEN=

# Je Richtung ein eigenes zufälliges Secret. Derselbe Wert muss in beiden
# beteiligten Instanzen stehen; nie den Gateway-Token dafür wiederverwenden.
# Produktleitung + Engineering-Leitung:
A2A_PRODUCT_TO_ENGINEERING=
A2A_ENGINEERING_TO_PRODUCT=
# Produktleitung + Programmleitung:
A2A_PRODUCT_TO_PARTNERSHIPS=
A2A_PARTNERSHIPS_TO_PRODUCT=

# Zugangsdaten des ausgewählten Modellproviders ergänzen, zum Beispiel:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
